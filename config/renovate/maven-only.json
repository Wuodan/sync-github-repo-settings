{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "forkProcessing": "enabled",
  "separateMajorMinor": false,
  "enabledManagers": ["maven"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["maven"],
      "groupName": "maven",
      "minimumReleaseAge": "3 days"
    }
  ]
}
