{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "forkProcessing": "enabled",
  "separateMajorMinor": false,
  "enabledManagers": ["github-actions", "custom.regex"],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^action\\.ya?ml$/"],
      "matchStrings": [
        "default:[ \\t]*[\\\"'`]?(?<currentValue>[^\\s\\\"'`]+)[\\\"'`]?[ \\t]*# renovate: datasource=(?<datasource>github-releases) depName=(?<depName>wslkit/skrog) versioning=(?<versioning>semver)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "[\\\"'`]?(?<currentValue>[^\\s\\\"'`]+)[\\\"'`]?[ \\t]*<!-- renovate: datasource=(?<datasource>github-releases) depName=(?<depName>wslkit/skrog) versioning=(?<versioning>semver) -->"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "minimumReleaseAge": "3 days"
    }
  ]
}
